{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Valores do chart alerta-cotacao",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "peers": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "properties": {
    "fullnameOverride": { "type": "string" },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": { "type": "string" },
        "imageTag": { "type": "string" },
        "imagePullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "imagePullSecrets": { "type": "array", "items": { "type": "object", "required": ["name"] } }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "javaToolOptions": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sem 'replicas' de propósito: o checker roda sempre com 1 réplica.",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "intervalSeconds": { "type": "integer", "minimum": 5 },
        "stockMinIntervalSeconds": { "type": "integer", "minimum": 0 },
        "marketHours": { "type": "string", "pattern": "^(sempre|always|24h|\\d{1,2}:\\d{2}-\\d{1,2}:\\d{2})$" },
        "failNoticeMinutes": { "type": "integer", "minimum": 0 },
        "dryRun": { "type": "boolean" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "storage": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
        "storageClassName": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jdbcUrl": { "type": "string", "pattern": "^(jdbc:postgresql://.+)?$" },
        "username": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "appToken": { "type": "string" },
        "checkerToken": { "type": "string" },
        "postgresPassword": { "type": "string" },
        "ntfyTopic": { "type": "string", "pattern": "^[-_A-Za-z0-9]{0,64}$" },
        "ntfyToken": { "type": "string" },
        "brapiToken": { "type": "string" },
        "awesomeapiToken": { "type": "string" },
        "telegramBotToken": { "type": "string" },
        "telegramChatId": { "type": "string" }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostnames"],
      "properties": {
        "hostnames": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "parentRefs": { "type": "array", "items": { "type": "object", "required": ["name"] } },
        "create": { "type": "boolean" },
        "className": { "type": "string" },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "httpsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" },
            "clusterIssuer": { "type": "string" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "gatewayFrom": { "$ref": "#/definitions/peers" },
        "ciliumGateway": { "type": "boolean" },
        "dns": { "$ref": "#/definitions/peers", "minItems": 1 },
        "checkerEgress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidr": { "type": "string" },
            "except": { "type": "array", "items": { "type": "string" } }
          }
        },
        "externalDatabaseCidr": { "type": "string" }
      }
    }
  }
}
