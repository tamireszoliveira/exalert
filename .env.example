# Copie para .env (que fica fora do git) e troque os tokens.
# Gere valores com:  openssl rand -hex 24

# PWA -> API (você cola este no app, em Ajustes)
APP_TOKEN=troque-este-token-do-app
# checker -> API (/internal). Precisa ser diferente do APP_TOKEN.
CHECKER_TOKEN=troque-este-token-do-checker

POSTGRES_PASSWORD=alerta

# Push pelo ntfy: invente um tópico difícil de adivinhar, assine no app ntfy do
# iPhone e cole aqui. Com NOTIFY_DRY_RUN=true o push só aparece no log do checker.
NTFY_TOPIC=
NOTIFY_DRY_RUN=true
# NTFY_TOKEN=            (se o tópico for protegido)

# Sem BRAPI_TOKEN a brapi só responde PETR4, VALE3, MGLU3 e ITUB4.
# BRAPI_TOKEN=
# AWESOMEAPI_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# CHECK_INTERVAL_SECONDS=120
# MARKET_HOURS=09:00-18:30     (seg a sex, horário de Brasília; "sempre" para 24 h)
# GATEWAY_PORT=8080
